                                onClick={() => { setTrack(id); setTopicId('all'); }}
                                className={`px-3 py-1.5 rounded-xl text-xs font-semibold border transition-all ${
                                    track === id ? 'bg-blue-600 text-white border-blue-600' : 'border-slate-200 text-slate-600 hover:bg-slate-50'
