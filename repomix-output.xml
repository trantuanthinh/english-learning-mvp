                <div>
                    <label className="text-xs font-bold text-slate-500 uppercase tracking-wider">Dạng câu hỏi</label>
                    <div className="flex flex-wrap gap-2 mt-1.5">
                        {TYPE_OPTIONS.map(({id, label}) => (
                            <button
                                key={id}
